# Copy to .env.local and fill in values. .env*.local files are git-ignored.
#
# Every EXPO_PUBLIC_* variable is embedded in the app bundle and is readable by
# anyone with the app. Never put a Supabase secret/service-role key or an AI
# provider API key here; those belong in Supabase Edge Function secrets.

# Supabase project (required from Phase 3; leave blank to run the app without a backend)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opt in to the optional AI assistant (implemented in Phase 6). When false, the
# Coach tab explains that AI features are turned off.
EXPO_PUBLIC_AI_ASSISTANT_ENABLED=false
